# Required for both dev and deployment.
NEXT_PUBLIC_SANITY_PROJECT_ID=ihcvo75q
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical production URL used by robots.txt, sitemap.xml, OG tags
# and canonical <link>s. Set to the final domain (e.g.
# https://www.ebb-law.com) on the Vercel Production environment so
# Google indexes one stable host instead of the vercel.app preview.
# NEXT_PUBLIC_SITE_URL=https://ebb-law.vercel.app

# Optional — defaults to "2026-06-22" if unset.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-06-22

# Only needed for scripts/migrate-to-sanity.mjs (one-time bootstrap).
# Create at https://www.sanity.io/manage → Project → API → Tokens (Editor role).
# DO NOT commit a populated value.
# SANITY_API_READ_TOKEN=

# Required for the /api/contact route to write contactSubmission
# documents into Sanity. Create at
# https://www.sanity.io/manage → Project → API → Tokens with
# "Contributor" (or "Editor") permissions. Set on the Vercel project
# — do NOT commit a populated value here.
# SANITY_API_WRITE_TOKEN=
